# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# Used by better-auth to sign session cookies and JWTs.
BETTER_AUTH_SECRET=

# Base URL of this Next.js app.
BETTER_AUTH_URL=http://localhost:3000

# MongoDB Atlas connection string. Both the client and the Express server
# must use the "OnRent" database.
MONGODB_URI=

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials).
# Authorized redirect URI must be exactly:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Express API URL (used by the frontend in later phases).
NEXT_PUBLIC_API_URL=http://localhost:5000
